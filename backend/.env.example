# Copy to .env (or set in the environment) and adjust.
REDGRID_DATABASE=instance/redgrid.sqlite3
REDGRID_DATA_DIR=data
# Frontend origins allowed to call the API (comma-separated)
REDGRID_CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
# Provider chains: comma-separated, tried in order. The last one must be local (algorithm / defaults).
REDGRID_COST_PROVIDERS=algorithm
REDGRID_PRIORITY_RESOLVERS=algorithm
REDGRID_RESOURCE_PROVIDERS=sensor,defaults
# Remote providers (only used when listed above)
REDGRID_MODEL_COST_URL=
REDGRID_MODEL_PRIORITY_URL=
REDGRID_SENSOR_URL=
