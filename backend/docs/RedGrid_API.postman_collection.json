{
 "info": {
  "name": "RedGrid API",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Every RedGrid endpoint with example bodies. Run the backend (flask --app redgrid run, or waitress), then run 'Missions > Create mission' first: it saves {{missionId}} for the other requests. Valid points in the demo data: longitude 77.33-77.50, latitude 18.40-18.51."
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://localhost:5000/api"
  },
  {
   "key": "missionId",
   "value": "1"
  },
  {
   "key": "routeId",
   "value": "1"
  },
  {
   "key": "annotationId",
   "value": "1"
  }
 ],
