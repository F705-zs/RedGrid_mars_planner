  {
   "name": "3. Missions",
   "item": [
    {
     "name": "Create mission (CUSTOM mix) - run first",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/missions",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "missions"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"regionId\": 1,\n  \"name\": \"Delta walk\",\n  \"objective\": \"Reach the delta front\",\n  \"startLon\": 77.4509,\n  \"startLat\": 18.4446,\n  \"destLon\": 77.3833,\n  \"destLat\": 18.4699,\n  \"profile\": \"CUSTOM\",\n  \"priorityMix\": [\n    {\n      \"presetKey\": \"BALANCED\",\n      \"percent\": 60\n    },\n    {\n      \"presetKey\": \"SCIENCE_FOCUSED\",\n      \"percent\": 40\n    }\n  ],\n  \"reserveFraction\": 0.2,\n  \"startIsBase\": true,\n  \"resources\": {\n    \"oxygenKg\": 0.6,\n    \"batteryWh\": 800\n  }\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('201 Created', () => pm.response.to.have.status(201));",
         "pm.collectionVariables.set('missionId', pm.response.json().id);"
        ]
       }
      }
     ]
    },
