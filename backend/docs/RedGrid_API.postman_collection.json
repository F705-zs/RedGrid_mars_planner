       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('4 routes', () => pm.expect(pm.response.json().length).to.eql(4));",
         "pm.collectionVariables.set('routeId', pm.response.json()[3].id);"
