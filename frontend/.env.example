# RedGrid frontend configuration (copy to .env.local and adjust)
# RedGrid API (backend V6). The app always uses it; if it is unreachable you get a banner with Retry, never fake data.
VITE_API_BASE_URL=http://localhost:5000/api
# Offline UI development only: answer from src/mocks test fixtures instead of the API. Leave false.
VITE_USE_MOCKS=false
# Primary basemap: NASA Mars Trek WMTS (EQ, default028mm). Default is the Viking MDIM 2.1 colour mosaic (232 m/px).
# VITE_MARS_BASE_TILE_URL=https://trek.nasa.gov/tiles/Mars/EQ/Mars_Viking_MDIM21_ClrMosaic_global_232m/1.0.0/default/default028mm/{z}/{y}/{x}.jpg
# VITE_MARS_BASE_MAX_NATIVE_ZOOM=7
# Where the 3D Jezero walk is served (built into public/mars3d by `bun run build:3d`)
# VITE_MARS3D_URL=/mars3d/index.html
